# Replace placeholders in hosting secrets. The application does not load .env files.
APP_ENV=production
ADMIN_PASSWORD=CHANGE_TO_A_UNIQUE_RANDOM_PASSWORD_AT_LEAST_32_CHARACTERS
SESSION_SECRET=CHANGE_TO_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_43_CHARACTERS

# Use an absolute path on persistent storage, not an ephemeral filesystem.
DATABASE_PATH=/var/data/pangasalama.sqlite3
IMAGE_STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=
# Optional for S3-compatible providers. Leave empty for AWS S3.
S3_ENDPOINT_URL=

# Development only; use a private persistent volume if testing local uploads.
LOCAL_IMAGE_STORAGE_PATH=./private_uploads

# Form notifications are addressed to these contacts by default.
PRIMARY_NOTIFICATION_EMAIL=ezekianyamhanga@gmail.com
BACKUP_NOTIFICATION_EMAIL=miriamnyamhanga237@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
# International digits for the wa.me contact link (0788525327 in Tanzania).
BUSINESS_WHATSAPP_NUMBER=255788525327

# Production startup rejects false or missing values; serve behind HTTPS.
SECURE_COOKIES=true
LOG_LEVEL=INFO
